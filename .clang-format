# GNUS-NEO-SWARM clang-format configuration
# Matches CLAUDE.md Code Style + Software Engineering Handbook §4 (Code Layout)
#
# Run: clang-format -i <file>          (apply formatting)
#      clang-format --dry-run <file>    (check only)

BasedOnStyle: Microsoft
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120

# ── Allman / Ullman brace style (Handbook Standard 10) ──
BreakBeforeBraces: Allman

# ── Never put short bodies on one line ──
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

# ── Spacing ──
SpaceAfterCStyleCast: true
SpaceBeforeParens: ControlStatements
SpacesInParentheses: true
SpacesInAngles: false

# ── Pointers / references ──
PointerAlignment: Left
ReferenceAlignment: Left

# ── Access modifiers at same indent as class ──
AccessModifierOffset: 0

# ── Switch / case ──
IndentCaseLabels: true
IndentCaseBlocks: false

# ── Namespaces ──
NamespaceIndentation: All

# ── Include sorting ──
SortIncludes: true
IncludeBlocks: Preserve
